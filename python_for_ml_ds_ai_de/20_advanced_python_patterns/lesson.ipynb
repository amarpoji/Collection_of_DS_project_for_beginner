   "source": [
    "## 4. Descriptors and Metaclasses\n",
    "\n",
    "Descriptors control attribute access. Metaclasses control class creation. Both are advanced patterns used in frameworks like Django, SQLAlchemy, and Pydantic."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Descriptor: validates that a value is in range\n",
    "class ValidatedAttribute:\n",
    "    def __init__(self, validator):\n",
    "        self.validator = validator\n",
    "        self.data = {}\n",
    "    \n",
    "    def __get__(self, obj, objtype=None):\n",
    "        if obj is None:\n",
    "            return self\n",
    "        return self.data.get(id(obj), None)\n",
    "    \n",
    "    def __set__(self, obj, value):\n",
    "        if not self.validator(value):\n",
    "            raise ValueError(f'Invalid value: {value}')\n",
    "        self.data[id(obj)] = value\n",
    "    \n",
    "    def __delete__(self, obj):\n",
    "        del self.data[id(obj)]\n",
    "\n",
    "def between(min_val, max_val):\n",
    "    return lambda x: min_val <= x <= max_val\n",
    "\n",
    "class MLHyperParams:\n",
    "    learning_rate = ValidatedAttribute(between(0.0001, 1.0))\n",
    "    n_estimators = ValidatedAttribute(between(1, 10000))\n",
    "    max_depth = ValidatedAttribute(between(1, 1000))\n",
    "    \n",
    "    def __init__(self, lr=0.01, n_est=100, depth=10):\n",
    "        self.learning_rate = lr\n",
    "        self.n_estimators = n_est\n",
    "        self.max_depth = depth\n",
    "\n",
    "hp = MLHyperParams(0.01, 100, 10)\n",
    "print('Valid hyperparams:', hp.learning_rate, hp.n_estimators, hp.max_depth)\n",
    "\n",
    "try:\n",
    "    hp.learning_rate = 5.0  # Should fail\n",
    "except ValueError as e:\n",
    "    print(f'Validation works! Caught: {e}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Mixins: Reusable Behaviors\n",
    "\n",
    "Mixins are small classes that provide reusable functionality through multiple inheritance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class LoggableMixin:\n",
    "    def log_info(self, message):\n",
    "        print(f'[INFO] [{self.__class__.__name__}] {message}')\n",
    "    \n",
    "    def log_error(self, message):\n",
    "        print(f'[ERROR] [{self.__class__.__name__}] {message}')\n",
    "\n",
    "class ConfigurableMixin:\n",
    "    def load_config(self, config_dict):\n",
    "        for key, value in config_dict.items():\n",
    "            setattr(self, key, value)\n",
    "        self.log_info(f'Loaded config: {config_dict}')\n",
    "\n",
    "class SerializableMixin:\n",
    "    def to_dict(self):\n",
    "        return {k: v for k, v in self.__dict__.items() if not k.startswith('_')}\n",
    "    \n",
    "    @classmethod\n",
    "    def from_dict(cls, data):\n",
    "        return cls(**{k: v for k, v in data.items() if not k.startswith('_')})\n",
    "\n",
    "class MLModel(LoggableMixin, ConfigurableMixin, SerializableMixin):\n",
    "    def __init__(self, name, version='1.0'):\n",
    "        self.name = name\n",
    "        self.version = version\n",
    "        self.log_info(f'Created model {name} v{version}')\n",
    "    \n",
    "    def predict(self, data):\n",
    "        self.log_info(f'Predicting {len(data)} samples')\n",
    "        return [0] * len(data)\n",
    "\n",
    "model = MLModel('RandomForest', '2.1')\n",
    "model.load_config({'n_estimators': 100, 'max_depth': 10})\n",
    "preds = model.predict([1, 2, 3])\n",
    "print('Serialized:', model.to_dict())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Design Patterns: Factory, Singleton, Observer\n",
    "\n",
    "Design patterns solve common problems in a structured way. Factory creates objects, singleton ensures one instance, observer enables event-driven communication."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Singleton: single model registry across the application\n",
    "class ModelRegistry:\n",
    "    _instance = None\n",
    "    _models = {}\n",
    "    \n",
    "    def __new__(cls):\n",
    "        if cls._instance is None:\n",
    "            cls._instance = super().__new__(cls)\n",
    "        return cls._instance\n",
    "    \n",
    "    def register(self, name, model):\n",
    "        self._models[name] = model\n",
    "        print(f'[Registry] Registered model: {name}')\n",
    "    \n",
    "    def get(self, name):\n",
    "        return self._models.get(name)\n",
    "    \n",
    "    def list_models(self):\n",
    "        return list(self._models.keys())\n",
    "\n",
    "# Factory: create different model types\n",
    "class ModelFactory:\n",
    "    @staticmethod\n",
    "    def create(model_type, **kwargs):\n",
    "        if model_type == 'random_forest':\n",
    "            return {'type': 'rf', 'params': kwargs, 'created': time.time()}\n",
    "        elif model_type == 'linear':\n",
    "            return {'type': 'linear', 'params': kwargs, 'created': time.time()}\n",
    "        elif model_type == 'xgboost':\n",
    "            return {'type': 'xgb', 'params': kwargs, 'created': time.time()}\n",
    "        else:\n",
    "            raise ValueError(f'Unknown model type: {model_type}')\n",
    "\n",
    "# Observer: track metrics\n",
    "class MetricsTracker:\n",
    "    def __init__(self):\n",
    "        self._observers = []\n",
    "        self._metrics = {}\n",
    "    \n",
    "    def attach(self, observer):\n",
    "        self._observers.append(observer)\n",
    "    \n",
    "    def log_metric(self, name, value):\n",
    "        self._metrics[name] = value\n",
    "        for obs in self._observers:\n",
    "            obs.on_metric(name, value)\n",
    "\n",
    "class ConsoleLogger:\n",
    "    def on_metric(self, name, value):\n",
    "        print(f'[Metric] {name}: {value}')\n",
    "\n",
    "class HistoryTracker:\n",
    "    def __init__(self):\n",
    "        self.history = []\n",
    "    def on_metric(self, name, value):\n",
    "        self.history.append((name, value, time.time()))\n",
    "\n",
    "print('Design patterns: Singleton, Factory, Observer defined')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demo: using all three patterns together\n",
    "print('=== Design Patterns in Action ===')\n",
    "\n",
    "# Singleton registry\n",
    "registry = ModelRegistry()\n",
    "registry2 = ModelRegistry()\n",
    "print(f'Same instance? {registry is registry2}')\n",
    "\n",
    "# Factory creates models\n",
    "rf_model = ModelFactory.create('random_forest', n_estimators=100)\n",
    "xgb_model = ModelFactory.create('xgboost', learning_rate=0.1)\n",
    "\n",
    "registry.register('rf_v1', rf_model)\n",
    "registry.register('xgb_v1', xgb_model)\n",
    "print(f'Registered models: {registry.list_models()}')\n",
    "\n",
    "# Observer tracks metrics\n",
    "tracker = MetricsTracker()\n",
    "logger = ConsoleLogger()\n",
    "history = HistoryTracker()\n",
    "tracker.attach(logger)\n",
    "tracker.attach(history)\n",
    "\n",
    "tracker.log_metric('accuracy', 0.95)\n",
    "tracker.log_metric('f1_score', 0.93)\n",
    "print(f'History entries: {len(history.history)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Dependency Injection for Testable ML Code\n",
    "\n",
    "Dependency injection passes dependencies explicitly, making components testable and swappable."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from dataclasses import dataclass, field\n",
    "from typing import Optional\n",
    "\n",
    "@dataclass\n",
    class PipelineConfig:\n",
    "    model_type: str = 'random_forest'\n",
    "    n_estimators: int = 100\n",
    "    max_depth: Optional[int] = None\n",
    "    batch_size: int = 32\n",
    "    normalize: bool = True\n",
    "\n",
    "class Preprocessor:\n",
    "    def fit_transform(self, X):\n",
    "        print(f'[Preprocessor] Processing {len(X)} samples')\n",
    "        return X\n",
    "\n",
    "class MLPipeline:\n",
    "    \"\"\"Production ML pipeline with dependency injection.\"\"\"\n",
    "    def __init__(self, config, model_factory, preprocessor, metrics):\n",
    "        self.config = config\n",
    "        self.model_factory = model_factory\n",
    "        self.preprocessor = preprocessor\n",
    "        self.metrics = metrics\n",
    "        self.model = None\n",
    "        self.log_info(f'Pipeline initialized with {config.model_type}')\n",
    "    \n",
    "    def build(self):\n",
    "        self.model = self.model_factory.create(\n",
    "            self.config.model_type,\n",
    "            n_estimators=self.config.n_estimators,\n",
    "            max_depth=self.config.max_depth\n",
    "        )\n",
    "        return self\n",
    "    \n",
    "    def run(self, X, y=None):\n",
    "        X_processed = self.preprocessor.fit_transform(X)\n",
    "        if y is not None:\n",
    "            self.metrics.log_metric('samples', len(X))\n",
    "        print(f'[Pipeline] Run complete using {self.config.model_type}')\n",
    "\n",
    "# Build pipeline with injected dependencies\n",
    "config = PipelineConfig()\n",
    "pipeline = MLPipeline(\n",
    "    config=config,\n",
    "    model_factory=ModelFactory(),\n",
    "    preprocessor=Preprocessor(),\n",
    "    metrics=tracker\n",
    ")\n",
    "pipeline.build()\n",
    "pipeline.run([1, 2, 3, 4, 5])\n",
    "\n",
    "print('\\nDI makes it easy to swap components for testing:')\n",
    "print('  pipeline = MLPipeline(config, MockFactory(), MockPreprocessor(), MockTracker())')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Config Objects and Pipeline Composition\n",
    "\n",
    "Using dataclasses for configuration and composing pipeline steps leads to clean, maintainable ML code."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from dataclasses import dataclass\n",
    "from typing import List\n",
    "\n",
    "@dataclass\n",
    class DataConfig:\n",
    "    path: str = './data'\n",
    "    test_size: float = 0.2\n",
    "    val_size: float = 0.1\n",
    "    random_state: int = 42\n",
    "    target_column: str = 'target'\n",
    "    feature_columns: List[str] = field(default_factory=lambda: ['f1', 'f2', 'f3'])\n",
    "\n",
    "@dataclass\n",
    class TrainingConfig:\n",
    "    model_type: str = 'random_forest'\n",
    "    n_estimators: int = 100\n",
    "    max_depth: int = 10\n",
    "    learning_rate: float = 0.01\n",
    "    cv_folds: int = 5\n",
    "\n",
    "@dataclass\n",
    class DeploymentConfig:\n",
    "    model_version: str = '1.0'\n",
    "    batch_size: int = 32\n",
    "    use_gpu: bool = False\n",
    "    cache_predictions: bool = True\n",
    "\n",
    "@dataclass\n",
    class MLConfig:\n",
    "    data: DataConfig = field(default_factory=DataConfig)\n",
    "    training: TrainingConfig = field(default_factory=TrainingConfig)\n",
    "    deployment: DeploymentConfig = field(default_factory=DeploymentConfig)\n",
    "    \n",
    "    def __post_init__(self):\n",
    "        self.validate()\n",
    "    \n",
    "    def validate(self):\n",
    "        assert 0 < self.data.test_size < 1, 'test_size must be between 0 and 1'\n",
    "        assert self.training.n_estimators > 0, 'n_estimators must be positive'\n",
    "\n",
    "# Compose pipeline steps\n",
    "class PipelineStep:\n",
    "    def __init__(self):\n",
    "        self.next_step = None\n",
    "    \n",
    "    def set_next(self, step):\n",
    "        self.next_step = step\n",
    "        return step\n",
    "    \n",
    "    def execute(self, data):\n",
    "        processed = self.process(data)\n",
    "        if self.next_step:\n",
    "            return self.next_step.execute(processed)\n",
    "        return processed\n",
    "\n",
    "class ValidateStep(PipelineStep):\n",
    "    def process(self, data):\n",
    "        print(f'[Validate] {len(data)} items')\n",
    "        return data\n",
    "\n",
    "class TrainStep(PipelineStep):\n",
    "    def process(self, data):\n",
    "        print(f'[Train] Training model...')\n",
    "        return {'model': 'trained', 'data': data}\n",
    "\n",
    "class EvaluateStep(PipelineStep):\n",
    "    def process(self, data):\n",
    "        print(f'[Evaluate] Scoring model...')\n",
    "        data['score'] = 0.95\n",
    "        return data\n",
    "\n",
    "# Build pipeline\n",
    "pipeline = ValidateStep()\n",
    "pipeline.set_next(TrainStep()).set_next(EvaluateStep())\n",
    "result = pipeline.execute(range(100))\n",
    "print(f'Pipeline result: {result}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary\n",
    "\n",
    "In this lesson, you learned:\n",
    "- **Decorators**: @timer, @retry, @log_calls, @memoize for ML pipelines\n",
    "- **Generators**: batch_generator, data stream pipelines for memory efficiency\n",
    "- **Context Managers**: model_session, experiment_tracker for resource cleanup\n",
    "- **Descriptors**: validated attributes for ML hyperparameters\n",
