    "# Module 20: Advanced Python Patterns\n",
    "\n",
    "**Lesson: Production Patterns for ML Systems**\n",
    "\n",
    "This notebook covers decorators, generators, context managers, descriptors, metaclasses, mixins, and design patterns (factory, singleton, observer, dependency injection) with ML-focused examples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "import random\n",
    "from functools import wraps\n",
    "print('Advanced Python patterns loaded')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Decorators: Logging, Timing, Retry\n",
    "\n",
    "Decorators wrap functions with additional behavior. They're essential for cross-cutting concerns like logging, timing, retry logic, and caching in ML pipelines."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic decorator: timing\n",
    "def timer(func):\n",
    "    @wraps(func)\n",
    "    def wrapper(*args, **kwargs):\n",
    "        start = time.perf_counter()\n",
    "        result = func(*args, **kwargs)\n",
    "        elapsed = time.perf_counter() - start\n",
    "        print(f'[{func.__name__}] completed in {elapsed:.4f}s')\n",
    "        return result\n",
    "    return wrapper\n",
    "\n",
    "# Decorator with arguments: retry\n",
    "def retry(max_attempts=3, delay=1.0, backoff=2.0):\n",
    "    def decorator(func):\n",
    "        @wraps(func)\n",
    "        def wrapper(*args, **kwargs):\n",
    "            last_exception = None\n",
    "            for attempt in range(1, max_attempts + 1):\n",
    "                try:\n",
    "                    return func(*args, **kwargs)\n",
    "                except Exception as e:\n",
    "                    last_exception = e\n",
    "                    wait = delay * (backoff ** (attempt - 1))\n",
    "                    print(f'[{func.__name__}] Attempt {attempt}/{max_attempts} failed: {e}')\n",
    "                    if attempt < max_attempts:\n",
    "                        print(f'  Retrying in {wait:.1f}s...')\n",
    "                        time.sleep(wait)\n",
    "            raise last_exception\n",
    "        return wrapper\n",
    "    return decorator\n",
    "\n",
    "# Apply decorators\n",
    "@timer\n",
    "@retry(max_attempts=3, delay=0.1)\n",
    def unstable_predict(data):\n",
    "    if random.random() < 0.6:  # 60% failure rate\n",
    "        raise ConnectionError('API timeout')\n",
    "    return {'prediction': 1, 'confidence': 0.95}\n",
    "\n",
    "print('=== Retry Decorator in Action ===')\n",
    "for i in range(3):\n",
    "    try:\n",
    "        result = unstable_predict({'feature': i})\n",
    "        print(f'  Success: {result}')\n",
    "    except Exception as e:\n",
    "        print(f'  Failed after all retries: {e}')\n",
    "    print()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Logging decorator for ML pipeline\n",
    "def log_calls(func):\n",
    "    @wraps(func)\n",
    "    def wrapper(*args, **kwargs):\n",
    "        arg_summary = f'args={len(args)}, kwargs={list(kwargs.keys())}'\n",
    "        print(f'[ML Pipeline] Calling {func.__name__}({arg_summary})')\n",
    "        result = func(*args, **kwargs)\n",
    "        print(f'[ML Pipeline] {func.__name__} returned')\n",
    "        return result\n",
    "    return wrapper\n",
    "\n",
    "# Caching decorator for model predictions\n",
    "def memoize(func):\n",
    "    cache = {}\n",
    "    @wraps(func)\n",
    "    def wrapper(*args, **kwargs):\n",
    "        key = str(args) + str(sorted(kwargs.items()))\n",
    "        if key not in cache:\n",
    "            cache[key] = func(*args, **kwargs)\n",
    "        return cache[key]\n",
    "    return wrapper\n",
    "\n",
    "print('Logging and memoization decorators defined')\n",
    "print('  - log_calls: traces ML pipeline execution')\n",
    "print('  - memoize: caches predictions for repeated inputs')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Generators: Memory-efficient Data Processing\n",
    "\n",
    "Generators produce values lazily, making them ideal for large datasets that don't fit in memory."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generator: stream data in batches\n",
    "def batch_generator(data, batch_size=32):\n",
    "    \"\"\"Yield batches of data for training/inference.\"\"\"\n",
    "    n = len(data)\n",
    "    for i in range(0, n, batch_size):\n",
    "        yield data[i:i + batch_size]\n",
    "\n",
    "# Generator: infinite data augmentation stream\n",
    "def augment_data_stream(data, augment_fn, max_augmented=None):\n",
    "    \"\"\"Yield original and augmented data.\"\"\"\n",
    "    count = 0\n",
    "    while max_augmented is None or count < max_augmented:\n",
    "        for item in data:\n",
    "            yield item  # Original\n",
    "            yield augment_fn(item)  # Augmented\n",
    "            count += 1\n",
    "            if max_augmented and count >= max_augmented:\n",
    "                return\n",
    "\n",
    "# Simple data pipeline with generators\n",
    "def load_data():\n",
    "    for i in range(100):\n",
    "        yield {'id': i, 'value': random.random()}\n",
    "\n",
    "def preprocess(stream):\n",
    "    for item in stream:\n",
    "        item['scaled'] = item['value'] * 2 - 1\n",
    "        yield item\n",
    "\n",
    "# Compose generators (lazy evaluation)\n",
    "pipeline = preprocess(load_data())\n",
    "for i, item in enumerate(pipeline):\n",
    "    if i < 3:\n",
    "        print(f'  Item {item[\"id\"]}: value={item[\"value\"]:.3f}, scaled={item[\"scaled\"]:.3f}')\n",
    "print('  ...')\n",
    "print(f'Generators process items lazily - no memory burst!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Context Managers: Resource Management\n",
    "\n",
    "Context managers handle setup and teardown automatically using the `with` statement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from contextlib import contextmanager\n",
    "\n",
    "# Context manager using contextlib\n",
    "@contextmanager\n",
    def model_session(model_name, version='1.0'):\n",
    "    print(f'[Session] Loading model {model_name} v{version}...')\n",
    "    # Simulate model loading\n",
    "    model = {'name': model_name, 'version': version, '_loaded': True}\n",
    "    try:\n",
    "        print(f'[Session] Model ready')\n",
    "        yield model\n",
    "    finally:\n",
    "        print(f'[Session] Unloading model {model_name}...')\n",
    "        model['_loaded'] = False\n",
    "        print(f'[Session] Cleanup complete')\n",
    "\n",
    "@contextmanager\n",
    def experiment_tracker(experiment_name):\n",
    "    print(f'[Experiment] Starting: {experiment_name}')\n",
    "    metrics = {}\n",
    "    try:\n",
    "        yield metrics\n",
    "    finally:\n",
    "        print(f'[Experiment] Logging metrics: {metrics}')\n",
    "        print(f'[Experiment] Finished: {experiment_name}')\n",
    "\n",
    "# Use context managers\n",
    "print('=== Context Manager Demo ===')\n",
    "with model_session('random_forest', '2.1') as model, \\\n",
    "     experiment_tracker('training_run_1') as tracker:\n",
    "    print(f'  Using model: {model[\"name\"]} v{model[\"version\"]}')\n",
    "    time.sleep(0.1)  # Simulate work\n",
    "    tracker['accuracy'] = 0.95\n",
    "    tracker['f1_score'] = 0.93\n",
    "print('\\nContext managers handle setup and teardown automatically!')"
   ]
  },
  {
   "cell_type": "markdown",
